# Copy this file to .env and fill in real values. Never commit .env itself -
# it holds live secrets. This file (.env.example) must only ever contain
# placeholders.

PROJECT_NAME="NEXUS-X"

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Every JWT is signed with this - anyone who has it can forge valid login
# tokens for any user. Must be unique per environment and never reused
# between dev/staging/production.
SECRET_KEY="REPLACE_WITH_A_GENERATED_RANDOM_SECRET"

DATABASE_URL="sqlite:///./nexus.db"

# https://console.groq.com/keys
GROQ_API_KEY="REPLACE_WITH_YOUR_GROQ_API_KEY"
GROQ_MODEL="openai/gpt-oss-20b"

# Neo4j Aura (https://console.neo4j.io) or self-hosted. On Aura, NEO4J_URI
# looks like neo4j+s://<id>.databases.neo4j.io - leave NEO4J_DATABASE unset
# on Aura (it auto-generates a non-"neo4j" default database name).
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="REPLACE_WITH_YOUR_NEO4J_PASSWORD"

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional: auto-creates ONE admin account on first boot, only if the users
# table is empty. Leave both unset and use `python scripts/create_admin.py`
# instead for normal setup/reset - that path never touches this file.
# INITIAL_ADMIN_USERNAME=""
# INITIAL_ADMIN_PASSWORD=""
